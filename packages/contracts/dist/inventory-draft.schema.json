{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Short room name, unique in the home, e.g. 'Bedroom 2'"
          },
          "roomType": {
            "type": "string",
            "enum": [
              "living_room",
              "family_room",
              "dining_room",
              "kitchen",
              "bedroom",
              "kids_room",
              "nursery",
              "office",
              "bathroom",
              "laundry",
              "hallway",
              "garage",
              "basement",
              "attic",
              "patio",
              "storage",
              "other"
            ]
          },
          "fullness": {
            "type": "string",
            "enum": [
              "sparse",
              "average",
              "full",
              "packed"
            ],
            "description": "How full closets, cabinets and shelves look: drives the packed-box estimate"
          },
          "coverageGaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Places not shown, e.g. 'closet not opened'"
          }
        },
        "required": [
          "label",
          "roomType",
          "fullness",
          "coverageGaps"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalogId": {
            "description": "Catalog id, or null when nothing in the catalog fits",
            "type": [
              "string",
              "null"
            ]
          },
          "customLabel": {
            "description": "Plain-English name when catalogId is null",
            "type": [
              "string",
              "null"
            ]
          },
          "room": {
            "type": "string",
            "description": "label of the room it is in"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "How sure you are of the item, its variant and its count"
          },
          "frameIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Frames where it is clearly visible, best first"
          },
          "notMoving": {
            "type": "boolean",
            "description": "Narration says it stays, or it is clearly a fixture"
          },
          "approxDims": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "l": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "l",
                  "w",
                  "h"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Outside size in inches, for items not in the catalog; null otherwise"
          },
          "note": {
            "description": "Anything a mover should know, e.g. 'glass top', 'wall-mounted'",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "catalogId",
          "customLabel",
          "room",
          "quantity",
          "confidence",
          "frameIds",
          "notMoving",
          "approxDims",
          "note"
        ]
      }
    }
  },
  "required": [
    "rooms",
    "items"
  ]
}
