{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trucks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capacityCuFt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fillPct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "capacityCuFt",
          "fillPct"
        ]
      }
    },
    "extraTruckCuFt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "trips": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "boxCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "actualWorkHours": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "crewSize": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "serviceType": {
      "type": "string",
      "maxLength": 40
    },
    "weighTicketLbs": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "trucks",
    "extraTruckCuFt",
    "trips",
    "boxCount",
    "actualWorkHours",
    "crewSize",
    "serviceType",
    "weighTicketLbs"
  ]
}
