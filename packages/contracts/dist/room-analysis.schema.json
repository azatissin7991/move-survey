{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalogId": {
            "description": "Catalog item id, or null when nothing in the catalog fits",
            "type": [
              "string",
              "null"
            ]
          },
          "customLabel": {
            "description": "Plain-English name when catalogId is null",
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frameId": {
                  "type": "string"
                },
                "tMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "bbox": {
                  "minItems": 4,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "required": [
                "frameId",
                "tMs"
              ]
            }
          },
          "fragile": {
            "type": "boolean"
          },
          "needsDisassembly": {
            "type": "boolean"
          },
          "notGoingHint": {
            "type": "boolean",
            "description": "Narration or notes suggest it is not moving"
          },
          "needsMeasurement": {
            "type": "boolean",
            "description": "Size decides the variant or price and couldn't be read reliably"
          },
          "approxDims": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "l": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "description": "Which reference object the estimate leans on, e.g. 'door 80 in'"
                  }
                },
                "required": [
                  "l",
                  "w",
                  "h",
                  "basis"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "catalogId",
          "customLabel",
          "quantity",
          "confidence",
          "evidence",
          "fragile",
          "needsDisassembly",
          "notGoingHint",
          "needsMeasurement",
          "approxDims",
          "note"
        ]
      }
    },
    "fullness": {
      "type": "string",
      "enum": [
        "sparse",
        "average",
        "full",
        "packed"
      ]
    },
    "packedBoxesSeen": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "coverageGaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Places not shown, e.g. 'closet not opened'"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "MEASURE",
              "CONFIRM_COUNT",
              "IS_MOVING",
              "MORE_FOOTAGE"
            ]
          },
          "itemIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "itemIndex",
          "detail"
        ]
      }
    }
  },
  "required": [
    "items",
    "fullness",
    "packedBoxesSeen",
    "coverageGaps",
    "questions"
  ]
}
