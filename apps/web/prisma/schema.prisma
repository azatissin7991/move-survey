generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Status columns are Strings constrained by @move-survey/contracts + zod at
// every write boundary, same convention as the CRM. JSON columns hold
// contract-shaped data validated on the way in.

// ---------- Tenants ----------

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  webhookUrl    String   @default("")
  webhookSecret String
  // Per-tenant switches (confirmation required, retention days, ...).
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())

  apiKeys    ApiKey[]
  surveys    Survey[]
  deliveries WebhookDelivery[]
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the key, shown in admin and used to find the row.
  prefix     String    @unique
  // sha256 of the whole key; the key itself is shown once and never stored.
  hash       String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- Surveys ----------

model Survey {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  externalRef    String
  publicToken    String    @unique
  status         String    @default("CREATED") // contracts SURVEY_STATUSES
  // Bumped whenever the published inventory changes; the CRM applies only newer ones.
  revision       Int       @default(0)
  // Optimistic lock for concurrent customer / estimator edits.
  version        Int       @default(0)
  language       String    @default("en")
  customer       Json
  move           Json      @default("{}")
  answers        Json      @default("{}")
  consentMedia   Boolean   @default(false)
  catalogVersion Int
  totals         Json?
  expiresAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rooms       SurveyRoom[]
  media       Media[]
  detections  Detection[]
  questions   Question[]
  corrections Correction[]
  outcome     Outcome?
  runs        PipelineRun[]

  @@index([tenantId, externalRef])
  @@index([status])
}

model SurveyRoom {
  id         String   @id @default(cuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomType   String // catalog ROOM_TYPES
  label      String
  sortOrder  Int
  status     String   @default("PENDING") // contracts ROOM_STATUSES
  // Bumped on every new recording; stage results for an older one are dropped.
  revision   Int      @default(0)
  quality    Json?
  transcript String   @default("")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  media      Media[]
  frames     Frame[]
  detections Detection[]

  @@index([surveyId])
}

// One recording (or photo) of a room. Video arrives as numbered chunks that
// concatenate into one file: MediaRecorder output is a single stream.
model Media {
  id          String   @id @default(cuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomId      String
  room        SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  revision    Int
  kind        String // VIDEO | PHOTO | AUDIO
  contentType String
  // Folder (prefix) holding chunk-00000, chunk-00001, ...
  storagePrefix String @unique
  chunkCount  Int      @default(0)
  sizeBytes   Int?
  durationMs  Int?
  status      String   @default("UPLOADING") // UPLOADING | COMPLETE | FAILED
  createdAt   DateTime @default(now())

  frames Frame[]

  @@index([roomId])
}

model Frame {
  id         String  @id @default(cuid())
  mediaId    String
  media      Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  roomId     String
  room       SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tMs        Int
  storageKey String
  // Anthropic Files API id, so stages and re-runs reference the image once.
  fileId     String?
  sharpness  Float
  selected   Boolean @default(false)

  @@index([roomId])
}

model Detection {
  id            String   @id @default(cuid())
  surveyId      String
  survey        Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomId        String
  room          SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  catalogItemId String?
  customLabel   String?
  variant       String?
  quantity      Int
  confidence    Float
  attributes    Json     @default("{}")
  evidence      Json     @default("[]")
  dims          Json?
  status        String   @default("PROPOSED") // contracts DETECTION_STATUSES
  source        String   @default("AI") // contracts DETECTION_SOURCES
  // Catalog values frozen at finalize, so catalog updates never move old surveys.
  valueSnapshot Json?
  mergedIntoId  String?
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  corrections Correction[]

  @@index([surveyId])
}

model Question {
  id          String    @id @default(cuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  detectionId String?
  kind        String // MEASURE | CONFIRM_COUNT | IS_MOVING | MORE_FOOTAGE
  params      Json      @default("{}")
  answer      Json?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([surveyId])
}

// Every human change to a detection: eval data and catalog feedback.
model Correction {
  id          String    @id @default(cuid())
  surveyId    String
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  detectionId String?
  detection   Detection? @relation(fields: [detectionId], references: [id], onDelete: SetNull)
  actor       String // "customer" or the CRM user's name
  before      Json?
  after       Json?
  createdAt   DateTime  @default(now())

  @@index([surveyId])
}

// Actuals from the CRM after the move (truck fill, hours, weigh ticket).
model Outcome {
  id         String   @id @default(cuid())
  surveyId   String   @unique
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  data       Json
  actualCuFt Float?
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PipelineRun {
  id            String    @id @default(cuid())
  surveyId      String
  survey        Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomId        String?
  roomRevision  Int?
  stage         String // contracts PIPELINE_STAGES
  status        String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | STALE
  attempt       Int       @default(1)
  outputKey     String?
  servedModel   String?
  promptVersion String?
  usage         Json?
  error         String    @default("")
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([surveyId])
  @@index([status, createdAt])
}

// Outbox: a row per webhook to send; the cron delivers with backoff.
model WebhookDelivery {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String    @default("")
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}
