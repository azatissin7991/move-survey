generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Status columns are Strings constrained by @move-survey/contracts + zod at
// every write boundary, same convention as the CRM.

// ---------- Tenants ----------

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  webhookUrl    String   @default("")
  webhookSecret String
  // { captureMode: "walkthrough" | "rooms", autoApprove: boolean }
  settings      Json     @default("{}")
  createdAt     DateTime @default(now())

  apiKeys    ApiKey[]
  surveys    Survey[]
  deliveries WebhookDelivery[]
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  // First characters of the key, used to find the row.
  prefix     String    @unique
  // sha256 of the whole key; the key itself is shown once and never stored.
  hash       String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- Surveys ----------

model Survey {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  externalRef    String
  publicToken    String    @unique
  status         String    @default("CREATED") // contracts SURVEY_STATUSES
  // Bumped whenever the published inventory changes; the CRM applies only newer ones.
  revision       Int       @default(0)
  language       String    @default("en")
  customer       Json
  move           Json      @default("{}")
  answers        Json      @default("{}")
  consentMedia   Boolean   @default(false)
  catalogVersion Int
  totals         Json? // contracts Totals
  suggestions    Json? // contracts Suggestions
  coverageGaps   Json      @default("[]") // ["Bedroom: closet not opened", …] shown to the reviewer
  expiresAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rooms       SurveyRoom[]
  media       Media[]
  frames      Frame[]
  detections  Detection[]
  corrections Correction[]
  outcome     Outcome?
  run         PipelineRun?

  @@index([tenantId, externalRef])
  @@index([status])
}

// One recorded segment: a walk-through part, or a room in room-by-room mode.
model SurveyRoom {
  id         String   @id @default(cuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomType   String? // set in room-by-room mode; otherwise the AI names rooms
  label      String
  sortOrder  Int
  transcript String   @default("")
  createdAt  DateTime @default(now())

  media  Media[]
  frames Frame[]

  @@index([surveyId])
}

// One stream of a segment, uploaded as numbered chunks under storagePrefix.
// VIDEO chunks concatenate into one file; each FRAMES chunk is one JPEG.
model Media {
  id            String     @id @default(cuid())
  surveyId      String
  survey        Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomId        String
  room          SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind          String // contracts MEDIA_KINDS
  contentType   String
  storagePrefix String     @unique
  chunkCount    Int        @default(0)
  sizeBytes     Int?
  durationMs    Int?
  status        String     @default("UPLOADING") // UPLOADING | COMPLETE
  createdAt     DateTime   @default(now())

  frames Frame[]

  @@index([surveyId])
}

model Frame {
  id         String     @id @default(cuid())
  surveyId   String
  survey     Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  roomId     String
  room       SurveyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tMs        Int
  storageKey String

  @@index([surveyId])
}

// One inventory line. The AI writes them at finalize; the reviewer may edit,
// add or mark them not moving. Values are frozen in `snapshot` so catalog
// updates never move an old survey.
model Detection {
  id            String   @id @default(cuid())
  surveyId      String
  survey        Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  roomLabel     String
  roomType      String
  catalogItemId String?
  customLabel   String?
  quantity      Int
  confidence    Float
  moving        Boolean  @default(true)
  estimated     Boolean  @default(false) // packed boxes estimated, not seen
  frameIds      Json     @default("[]")
  note          String   @default("")
  source        String   @default("AI") // contracts DETECTION_SOURCES
  snapshot      Json // { name, cuFtEach, weightLbsEach, flags }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  corrections Correction[]

  @@index([surveyId])
}

// Every reviewer change: eval data and catalog feedback.
model Correction {
  id          String     @id @default(cuid())
  surveyId    String
  survey      Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  detectionId String?
  detection   Detection? @relation(fields: [detectionId], references: [id], onDelete: SetNull)
  actor       String
  before      Json?
  after       Json?
  createdAt   DateTime   @default(now())

  @@index([surveyId])
}

// Actuals from the CRM after the move (truck fill, hours, weigh ticket).
model Outcome {
  id         String   @id @default(cuid())
  surveyId   String   @unique
  survey     Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  data       Json
  actualCuFt Float?
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// The analysis of one survey: its progress lives in `state`, so the work can
// be split across short function runs and resumed after a crash.
model PipelineRun {
  id          String    @id @default(cuid())
  surveyId    String    @unique
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  status      String    @default("RUNNING") // RUNNING | DONE | FAILED
  // Lease: only one function run works on a survey at a time.
  lockedUntil DateTime?
  state       Json      @default("{}")
  attempts    Int      @default(0)
  servedModel String   @default("")
  usage       Json     @default("{}")
  error       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, updatedAt])
}

// Outbox: a row per webhook to send; the cron delivers with backoff.
model WebhookDelivery {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  status        String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String    @default("")
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}
