# Postgres (Neon in production: pooled URL + direct URL for migrations)
DATABASE_URL="postgresql://user@localhost:5432/move_survey"
DIRECT_URL="postgresql://user@localhost:5432/move_survey"

# Public base URL, used in customer links handed to the CRM
APP_URL="http://localhost:3100"

# Signs local dev-storage upload URLs and customer-session values. Any long random string.
APP_SECRET="change-me"

# Storage: "local" (files under .data/, dev only) or "r2"
STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# AI: Claude reads the frames; Gemini (optional) transcribes narration
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Cron routes (pipeline steps, webhook delivery)
CRON_SECRET=""
